rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Audit logs: readable by clients, create allowed for audit logging
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Allowlisted applications: readable by all clients
    match /applications/{appId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles and nested drive bookmarks
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isSignedIn();

      match /driveBookmarks/{fileId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}


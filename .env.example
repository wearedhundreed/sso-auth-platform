# ==============================================================================
# SECURE MULTI-APPLICATION SSO PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Never commit actual production secrets, passwords, or keys to Git.
# Copy this file to .env.local for development or configure directly in your
# hosting provider's secrets manager (Vercel, AWS Secrets Manager, GitHub Secrets).
# ==============================================================================

# Core Application Base URL (Must use HTTPS in production)
APP_URL=https://YOUR-DOMAIN.example

# OpenID Connect (OIDC) / Auth0 Tenant Configuration
OIDC_ISSUER=https://YOUR-TENANT.auth0.com/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Strict Callback and Error Endpoints
OIDC_CALLBACK_URL=https://YOUR-DOMAIN.example/auth/callback
OIDC_ERROR_URL=https://YOUR-DOMAIN.example/auth/error
OIDC_LOGOUT_CALLBACK_URL=https://YOUR-DOMAIN.example/auth/logout

# PostgreSQL Database Connection String (Prisma ORM)
DATABASE_URL=

# Cryptographic Session Encryption / Signing Key (Minimum 32 random characters)
SESSION_SECRET=

# GitHub Webhook HMAC-SHA256 Secret
GITHUB_WEBHOOK_SECRET=

# Preferred GitHub OAuth SSO Provider Configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://YOUR-DOMAIN.example/auth/github/callback

# Node Environment (production | development | test)
NODE_ENV=production
